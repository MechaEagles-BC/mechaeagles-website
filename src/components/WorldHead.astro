---
/** Runs before the first paint on every page, so nothing flashes the wrong world. Moving between pages replaces the page's attributes, so the world is put back each time. */
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    function pick() {
      var q = new URLSearchParams(location.search), saved = null;
      try { saved = localStorage.getItem("mc-world"); } catch (e) {}
      return q.has("space") ? "space" : q.has("valley") ? "valley" : saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "space" : "valley");
    }
    function stamp(page) {
      root.dataset.theme = window.__mcWorld || (window.__mcWorld = pick());
      root.classList.add("js");
      if (window.__mcState) root.dataset.state = window.__mcState;
      root.classList.toggle("past-hero", !/^(home|legacy)$/.test(page) || scrollY > innerHeight * 0.4);
    }
    stamp(root.dataset.page);
    if (window.__mcStamp) return;
    window.__mcStamp = true;
    // Registered ahead of the router, so going back from a profile can close it without reloading the page behind it.
    addEventListener("popstate", function (e) { if (window.__mcPop) window.__mcPop(e); });
    // Registered before any picture can arrive. One that had to download comes into focus over its preview, and one already in the browser's cache just appears.
    document.addEventListener("load", function (e) {
      var img = e.target;
      if (img.tagName !== "IMG" || img.dataset.ph !== "in") return;
      var seen = performance.getEntriesByName(img.currentSrc).pop();
      if (!seen || seen.duration > 40) img.classList.add("ph-in");
    }, true);
    new MutationObserver(function () { window.__mcWorld = root.dataset.theme || window.__mcWorld; }).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    document.addEventListener("astro:before-swap", function (e) {
      // Done on the incoming page, before it's shown, so the swap never paints the wrong world.
      var next = e.newDocument.documentElement;
      next.dataset.theme = root.dataset.theme;
      next.classList.add("js");
      if (root.dataset.state) next.dataset.state = root.dataset.state;
      next.classList.toggle("past-hero", !/^(home|legacy)$/.test(next.dataset.page));
    });
    if (root.dataset.page === "home") {
      var dir = root.dataset.theme === "space" ? "/stills/space/" : "/stills/";
      [["wide", "(min-aspect-ratio: 9/10)"], ["tall", "(max-aspect-ratio: 9/10)"]].forEach(function (s) {
        var l = document.createElement("link");
        l.rel = "preload"; l.as = "image"; l.href = dir + "idle-" + s[0] + ".webp"; l.media = s[1]; l.fetchPriority = "high";
        document.head.appendChild(l);
      });
    }
  })();
</script>
