---
/** The one world behind every page: the turning sky in space, and leaves on the breeze in the valley. Fixed, and kept across pages, so it never starts over. */
const LEAVES: [number, number, number, string, number, number][] = [
  [4, 24, 0, "#7f9a4a", 18, 1], [17, 31, 9, "#5f7f3a", 9, 2], [31, 21, 15, "#a7a35a", 26, 3], [46, 36, 4, "#6d8a40", 13, 1],
  [62, 27, 20, "#8aa04e", 31, 2], [77, 33, 12, "#b4a862", 7, 3], [90, 25, 26, "#6d8a40", 22, 1],
];
---
<canvas id="sky" aria-hidden="true" transition:persist="sky"></canvas>
<div class="breeze" aria-hidden="true" transition:persist="breeze">
  {LEAVES.map((l) => <i class={`leaf-${l[5]}`} style={`--x:${l[0]}%;--t:${l[1]}s;--d:${l[2]}s;--leaf:${l[3]};--far:${l[4]}vw`}></i>)}
</div>
