---
import ElementArt from "./ElementArt.astro";
import Sigil from "./Sigil.astro";
import Photo from "../Photo.astro";
import { TEAM, type Card } from "../../data/org";

/**
 * One member, as one card, from their one record. A real link: it opens their profile on any page, can be copied or opened in a new tab, and works with a keyboard.
 * Their other roles show as small marks rather than as another copy of the card.
 */
const { card, style, hideTeam = false } = Astro.props as { card: Card; style?: string; hideTeam?: boolean };
const { member, org, role, rank, size, also } = card;
const team = TEAM[org];
const initials = member.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join("");
// The photo fills about four fifths of the card's width.
const SHOWS = { xl: "246px", l: "197px", m: "177px", s: "140px" };
const label = [member.name, role, team.name, ...also.map((a) => a.title)].join(", ");
---
<a class={`mcard mcard--${size} reveal`} data-el={team.element} data-person={member.id} data-roles={[org, ...also.map((a) => a.orgId)].join("|")} href={`/people/#${member.id}`} style={`--c:${team.color};${style ?? ""}`} aria-label={`${label}. Open profile`}>
  <span class="mcard__tilt">
    <ElementArt el={team.element} />
    <span class="mcard__glow"></span>
    {member.photo ? (
      <Photo class="mcard__photo" src={member.photo} sizes={SHOWS[size]} />
    ) : (
      <span class="mcard__monogram" aria-hidden="true">{initials}</span>
    )}
    <span class="mcard__top"><span class="mcard__rank">{rank}</span><Sigil el={team.element} /></span>
    <span class="mcard__plate">
      <span class="mcard__name">{member.name}</span>
      <span class="mcard__role">{role}</span>
      {!hideTeam && team.kind === "engineering" && <span class="mcard__team">{team.name}</span>}
      {also.length > 0 && (
        <span class="mcard__also" title={also.map((a) => a.title).join(" · ")}>
          {also.map((a) => <span style={`--c:${a.color}`}><Sigil el={a.element} /></span>)}
          <small>+{also.length} {also.length === 1 ? "role" : "roles"}</small>
        </span>
      )}
    </span>
    <span class="mcard__sheen"></span>
  </span>
</a>
