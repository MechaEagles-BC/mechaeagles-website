---
/** One small mark for each element, drawn in the same line weight so all five belong together. */
const { el } = Astro.props as { el: string };
---
<svg class="sigil" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
  {el === "earth" && <path d="M2.5 19.5 9 8l4 6 2.5-3.5L21.5 19.5Z" />}
  {el === "wind" && <path d="M2.5 9h11a3 3 0 1 0-3-3M2.5 14h15.5a2.8 2.8 0 1 1-2.8 2.8M5 18.5h6" />}
  {el === "fire" && <path d="M12 21.5c-4 0-6.8-2.8-6.8-6.4 0-3.4 2.6-5 3.6-8 .4 1.6 1.2 2.4 2.2 3 .2-3.2 1.4-5.8 3.6-7.6-.2 3 3.6 5.8 3.6 11 0 4-2.4 8-6.2 8Z" />}
  {el === "mind" && <><circle cx="5" cy="6" r="2" /><circle cx="19" cy="6" r="2" /><circle cx="12" cy="13" r="2.4" /><circle cx="6" cy="20" r="2" /><circle cx="18" cy="20" r="2" /><path d="m6.5 7.4 3.8 3.9M17.5 7.4l-3.8 3.9M10.6 14.9l-3.4 3.6M13.4 14.9l3.4 3.6" /></>}
  {el === "core" && <><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="3" /><path d="M12 3.5v5M12 15.5v5M3.5 12h5M15.5 12h5" /></>}
</svg>
