---
import Site from "../layouts/Site.astro";
---
<Site title="Page not found" page="404" description="This page doesn't exist on the MechaEagles site." noindex>
  <div class="page-head wrap">
    <p class="eyebrow reveal">404</p>
    <h1 class="reveal">This path doesn't lead anywhere</h1>
    <p class="lede reveal">The page may have moved, or the link may have a typo. The way back is below.</p>
    <div class="actions reveal"><a class="button button--solid" href="/">Back to Home</a><a class="button" href="/teams/">See the teams</a></div>
  </div>
</Site>
