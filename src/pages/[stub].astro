---
import "../styles/lab.css";
export const getStaticPaths = () => ["teams", "projects", "people", "sponsors", "about", "log", "join"].map((stub) => ({ params: { stub } }));
const { stub } = Astro.params;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>{stub} · prototype stub</title></head>
  <body><p class="note">Prototype stub for "{stub}". On the real site this link opens the existing page. <a href="/">Back</a></p></body>
</html>
