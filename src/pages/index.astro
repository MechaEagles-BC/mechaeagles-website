---
import "../styles/lab.css";
import Foundation from "../components/Foundation.tsx";
import { SIGNS, TEAMS } from "../components/teams";

const still = (name: string, dir = "") => ({ wide: `/stills/${dir}${name}-wide.webp`, tall: `/stills/${dir}${name}-tall.webp` });
const WORLDS = [{ dir: "", key: "valley" }, { dir: "space/", key: "space" }];
const STILLS = ["baja", "aero", "combat", "ai"];

// Copied from site/src/content for this prototype. Everyone here has consent "photo" on file, which the roster notes still need each member to confirm.
const PEOPLE_COUNT = 48;
const LATEST_LOG = { date: "19 Sep 2026", title: "First launch day: three up, two back", href: "/log/" };
const LEADS = [
  { name: "Sam Kaiser", title: "Baja Lead", photo: "sam-kaiser", color: TEAMS[0].color },
  { name: "Jack Tommaney", title: "Aero Lead · Payload Lead", photo: "jack-tommaney", color: TEAMS[1].color },
  { name: "Carlos Contreras", title: "Combat Robotics Lead", photo: "carlos-contreras", color: TEAMS[2].color },
  { name: "Ambrose McCullough", title: "AI Safety Lead", photo: "ambrose-mccullough", color: TEAMS[3].color },
];
const PROGRAM = [
  { name: "Austin Kinnealey", title: "Project Manager", photo: "austin-kinnealey" },
  { name: "Vedarsh Mishra", title: "Project Manager", photo: "vedarsh-mishra" },
  { name: "Lucas DiMarco", title: "DPM", photo: "lucas-dimarco" },
  { name: "Ambrose McCullough", title: "DPM / Programmatics", photo: "ambrose-mccullough" },
  { name: "Vladislav Hoila", title: "CS Lead", photo: "vladislav-hoila" },
];
// Carried over from the 2025-26 sponsors page. Confirm each entry with the partner before launch.
const PARTNERS = [
  { name: "SolidWorks", provided: "30 software licenses" },
  { name: "Autodesk Fusion", provided: "CAD software licenses and manufacturing support" },
  { name: "Boston College Engineering", provided: "Funding and shop access" },
  { name: "IGOS Welding", provided: "Bolts and welding materials" },
];
// Where each leaf starts, how long it falls, when it starts and its colour. A few, and all greens and straw, since the team colours are spoken for.
const LEAVES: [number, number, number, string][] = [[6, 19, 0, "#7f9a4a"], [18, 24, 6, "#5f7f3a"], [33, 21, 11, "#a7a35a"], [47, 27, 3, "#6d8a40"], [64, 23, 14, "#8aa04e"], [78, 26, 8, "#b4a862"]];
const NAV = [
  { label: "Teams", href: "/teams/" },
  { label: "People", href: "/people/" },
  { label: "Sponsors", href: "/sponsors/" },
  { label: "About", href: "/about/" },
  { label: "Log", href: "/log/" },
  { label: "Join", href: "/join/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="MechaEagles: four student engineering teams at Boston College." />
    <title>MechaEagles</title>
    <!-- Runs before the first paint, so the page never flashes the wrong world, and preloads only that world's picture. -->
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search), saved = null;
        try { saved = localStorage.getItem("mc-world"); } catch (e) {}
        var world = q.has("space") ? "space" : q.has("valley") ? "valley" : saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "space" : "valley");
        document.documentElement.dataset.theme = world;
        document.documentElement.classList.add("js");
        var dir = world === "space" ? "/stills/space/" : "/stills/";
        [["wide", "(min-aspect-ratio: 9/10)"], ["tall", "(max-aspect-ratio: 9/10)"]].forEach(function (s) {
          var l = document.createElement("link");
          l.rel = "preload"; l.as = "image"; l.href = dir + "idle-" + s[0] + ".webp"; l.media = s[1]; l.fetchPriority = "high";
          document.head.appendChild(l);
        });
      })();
    </script>
  </head>
  <body>
    <main>
      <section class="stage" aria-label="The four teams">
        <div class="stills" aria-hidden="true">
          {WORLDS.map((w) => (
            <picture class={`still only-${w.key}`}>
              <source media="(max-aspect-ratio: 9/10)" srcset={still("idle", w.dir).tall} />
              <img src={still("idle", w.dir).wide} alt="" width="1920" height="1080" loading="lazy" />
            </picture>
          ))}
          {WORLDS.map((w) => STILLS.map((t, i) => (
            <picture class="still still--team" data-still-team={i} data-world={w.key}>
              <source media="(max-aspect-ratio: 9/10)" data-srcset={still(t, w.dir).tall} />
              <img data-src={still(t, w.dir).wide} alt="" width="1920" height="1080" />
            </picture>
          )))}
        </div>
        <div class="top">
          <a class="top__logo logo" href="/" aria-label="MechaEagles home"><img src="/brand/eagle.webp" alt="" width="44" height="28" /><span>MechaEagles</span></a>
          <h1 class="top__line">Four student engineering teams at Boston College</h1>
        </div>
        <Foundation client:only="react" peopleCount={PEOPLE_COUNT} latestLog={LATEST_LOG} />
        <ul class="team-list">
          {TEAMS.map((t) => <li><a href={t.href} style={`--c:${t.color}`}>{t.name}</a></li>)}
        </ul>
        <nav class="sign-list only-valley" aria-label="Signpost"><ul class="sign-list__row" style="display:contents">{SIGNS.map((sign) => <li><a href={sign.href}>{sign.label}</a></li>)}</ul></nav>
        <div class="bottom">
          <p>Card drawings are illustrative. Baldwin-1 is a design model.</p>
          <a href="#people">Meet the people ↓</a>
        </div>
      </section>

      <section class="beat" id="people">
        <div class="drift drift--leaves only-valley" aria-hidden="true">
          {LEAVES.map((l) => <i style={`--x:${l[0]}%;--t:${l[1]}s;--d:${l[2]}s;--leaf:${l[3]}`}></i>)}
        </div>
        <div class="drift drift--stars only-space" aria-hidden="true"></div>
        <div class="wrap">
          <p class="eyebrow reveal">The people</p>
          <h2 class="reveal">Who leads the teams</h2>
          <div class="people__row people__row--4">
            {LEADS.map((p, i) => (
              <article class="person reveal" style={`--c:${p.color};--i:${i}`}>
                <img class="person__photo" src={`/people/${p.photo}.webp`} alt={`Portrait of ${p.name}`} loading="lazy" width="640" height="800" />
                <span class="person__name">{p.name}</span>
                <span class="person__title">{p.title}</span>
              </article>
            ))}
          </div>
          <div class="people__second">
            <h3 class="reveal">Who makes it possible</h3>
            <p class="lede reveal">Project management, outreach, operations and partnerships. None of the four teams runs without them.</p>
            <div class="people__row people__row--5">
              {PROGRAM.map((p, i) => (
                <article class="person reveal" style={`--i:${i}`}>
                  <img class="person__photo" src={`/people/${p.photo}.webp`} alt={`Portrait of ${p.name}`} loading="lazy" width="640" height="800" />
                  <span class="person__name">{p.name}</span>
                  <span class="person__title">{p.title}</span>
                </article>
              ))}
            </div>
          </div>
          <a class="people__all" href="/people/">See all {PEOPLE_COUNT} people</a>
        </div>
      </section>

      <section class="beat beat--support" id="support">
        <div class="drift drift--stars only-space" aria-hidden="true"></div>
        <div class="wrap support">
          <div class="reveal">
            <p class="eyebrow">For sponsors and faculty</p>
            <h2>What your support builds</h2>
            <dl class="support__facts">
              <div><dt>People</dt><dd>{PEOPLE_COUNT}</dd></div>
              <div><dt>Teams</dt><dd>{TEAMS.length}</dd></div>
            </dl>
            <p class="support__log lede">In September 2026, AeroEagles flew three rockets on its first high-power launch outing. Two were recovered, one was lost after its parachute didn't deploy, and Jack Tommaney earned Level 1 certification.</p>
            <div class="actions">
              <a class="button button--solid" href="mailto:mechaeagles@bc.edu?subject=Partnership%20inquiry">Partner with us</a>
              <a class="button" href="/Mecha_Eagles_Sponsorship_Packet.pdf">Sponsorship packet (PDF)</a>
            </div>
          </div>
          <div class="reveal" style="--i:2">
            <p class="eyebrow">What partners have provided</p>
            <ul class="partners">
              {PARTNERS.map((p) => <li><strong>{p.name}</strong><span>{p.provided}</span></li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="ending" id="join">
        <picture class="only-valley">
          <source media="(max-aspect-ratio: 9/10)" srcset="/plate/dusk-tall.webp" />
          <img class="ending__image" src="/plate/dusk.webp" alt="The MechaEagles platform at dusk with its circuits lit" loading="lazy" width="1920" height="1080" />
        </picture>
        <picture class="only-space">
          <source media="(max-aspect-ratio: 9/10)" srcset="/plate/space-end-tall.webp" />
          <img class="ending__image" src="/plate/space-end.webp" alt="The MechaEagles platform on a small moon with its circuits lit" loading="lazy" width="1920" height="1080" />
        </picture>
        <div class="ending__rocket only-space" aria-hidden="true"></div>
        <div class="ending__text wrap">
          <h2 class="ending__title reveal">Come build with us.</h2>
          <div class="actions reveal" style="--i:2"><a class="button button--solid" href="/join/">Join MechaEagles</a></div>
        </div>
      </section>
    </main>
    <footer class="foot">
      <div class="wrap">
        <div class="foot__row">
          <a class="logo" href="/"><img src="/brand/eagle.webp" alt="" width="44" height="28" loading="lazy" /><span>MechaEagles</span></a>
          <nav aria-label="Footer"><ul>{NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
          <a href="mailto:mechaeagles@bc.edu">mechaeagles@bc.edu</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var items = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) { items.forEach(function (el) { el.classList.add("in"); }); return; }
        var seen = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); seen.unobserve(e.target); } });
        }, { rootMargin: "0px 0px -8% 0px" });
        items.forEach(function (el) { seen.observe(el); });
      })();
    </script>
  </body>
</html>
