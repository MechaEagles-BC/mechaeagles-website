---
import Site from "../layouts/Site.astro";
import MemberCard from "../components/cards/MemberCard.astro";
import Sigil from "../components/cards/Sigil.astro";
import { ENGINEERING, LEADERS, PEOPLE_COUNT, RESPONSIBILITIES, LED_BY_LEADERSHIP, TEAM_LEADS, introOf, primaryCard, branchOf } from "../data/org";
import sponsors from "../data/sponsors.json";
---
<Site title="Home" page="home" description="MechaEagles: four student engineering teams at Boston College.">
  <h1 class="sr-only">MechaEagles: four student engineering teams at Boston College</h1>

  <dialog class="memory" id="memory" aria-label="Ash, a fragment found in the valley">
    <header class="memory__head">
      <img src="/people/vedarsh-mishra.webp" alt="" width="56" height="56" loading="lazy" />
      <div><h2>Ash</h2><p>A fragment, found in the valley</p></div>
      <button type="button" class="memory__close" data-memory-close>Close</button>
    </header>
    <div class="memory__log" data-memory-log aria-live="polite"></div>
    <div class="memory__chips" data-memory-chips></div>
    <form class="memory__ask" data-memory-form>
      <label class="sr-only" for="memory-input">Ask Ash something</label>
      <input id="memory-input" type="text" maxlength="200" placeholder="Ask Ash something" autocomplete="off" />
      <button type="submit">Ask</button>
    </form>
    <p class="memory__note"><span data-memory-disclosure></span> <a href="/people/#vedarsh-mishra">Meet the real one</a></p>
  </dialog>

  <section class="leaders" id="leadership">
    <div class="leaders__beam" aria-hidden="true"></div>
    <div class="wrap">
      <header class="leaders__head">
        <p class="eyebrow reveal">The people running MechaEagles</p>
        <h2 class="reveal">Meet our leadership</h2>
      </header>
      <div class="leaders__row">
        {LEADERS.map((m, i) => (
          <article class="leader reveal" style={`--i:${i}`}>
            <MemberCard card={primaryCard(m, "m")} />
            <div class="leader__text">
              <p>{introOf(m)}</p>
              {RESPONSIBILITIES(m).length > 0 && (
                <ul class="leader__jobs">
                  {RESPONSIBILITIES(m).map((r) => <li style={`--c:${r.color}`}><Sigil el={r.element} /><span>{r.title}<small>{r.team}</small></span></li>)}
                </ul>
              )}
              <a class="leader__more" data-person={m.id} href={`/people/#${m.id}`}>Full profile<span class="sr-only"> of {m.name}</span></a>
            </div>
          </article>
        ))}
      </div>
      <h3 class="leaders__sub reveal">Engineering team leads</h3>
      <div class="leaders__row leaders__row--leads">
        {TEAM_LEADS.map((m, i) => (
          <article class="leader reveal" style={`--i:${i}`}>
            <MemberCard card={primaryCard(m, "m")} />
            <div class="leader__text">
              <p>{introOf(m)}</p>
              <a class="leader__more" data-person={m.id} href={`/people/#${m.id}`}>Full profile<span class="sr-only"> of {m.name}</span></a>
            </div>
          </article>
        ))}
      </div>
      {LED_BY_LEADERSHIP.map((l) => <p class="leaders__note reveal">{l.team} is led by {l.name}, introduced above.</p>)}
      <a class="leaders__all reveal" href="/people/">See how all {PEOPLE_COUNT} people fit together</a>
    </div>
  </section>

  <section class="beat" id="teams">
    <div class="wrap">
      <p class="eyebrow reveal">What we build</p>
      <h2 class="reveal">Four engineering teams</h2>
      <ul class="tstrip">
        {ENGINEERING.map((t, i) => (
          <li class="reveal" style={`--c:${t.color};--i:${i}`}>
            <a href={`/teams/${t.id}/`}>
              <Sigil el={t.element} />
              <strong>{t.name}</strong>
              <span>{t.tagline}</span>
              <small>{branchOf(t).everyone.length} people</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="beat beat--support" id="support">
    <div class="wrap support">
      <div class="reveal">
        <p class="eyebrow">For sponsors and faculty</p>
        <h2>What your support builds</h2>
        <dl class="support__facts">
          <div><dt>People</dt><dd>{PEOPLE_COUNT}</dd></div>
          <div><dt>Teams</dt><dd>{ENGINEERING.length}</dd></div>
        </dl>
        <p class="support__log lede">In September 2026, AeroEagles flew three rockets on its first high-power launch outing. Two were recovered, one was lost after its parachute didn't deploy, and Jack Tommaney earned Level 1 certification.</p>
        <div class="actions">
          <a class="button button--solid" href="/sponsors/">Partner with us</a>
          <a class="button" href="/Mecha_Eagles_Sponsorship_Packet.pdf" data-astro-reload>Sponsorship packet (PDF)</a>
        </div>
      </div>
      <div class="reveal" style="--i:2">
        <p class="eyebrow">What partners have provided, 2025–26</p>
        <ul class="partners">
          {sponsors.partners.map((p) => <li><strong>{p.name}</strong><span>{p.provided}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="ending" id="join">
    <picture class="only-valley">
      <source media="(max-aspect-ratio: 9/10)" srcset="/plate/dusk-tall.webp" />
      <img class="ending__image" src="/plate/dusk.webp" alt="The MechaEagles platform at dusk with its circuits lit" loading="lazy" width="1920" height="1080" />
    </picture>
    <picture class="only-space">
      <source media="(max-aspect-ratio: 9/10)" srcset="/plate/space-end-tall.webp" />
      <img class="ending__image" src="/plate/space-end.webp" alt="The MechaEagles platform on a small moon with its circuits lit" loading="lazy" width="1920" height="1080" />
    </picture>
    <div class="ending__text wrap">
      <h2 class="ending__title reveal">Come build with us.</h2>
      <div class="actions reveal" style="--i:2"><a class="button button--solid" href="/join/">Join MechaEagles</a></div>
    </div>
  </section>
</Site>
