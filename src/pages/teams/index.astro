---
import Site from "../../layouts/Site.astro";
import ElementArt from "../../components/cards/ElementArt.astro";
import Sigil from "../../components/cards/Sigil.astro";
import Photo from "../../components/Photo.astro";
import { ENGINEERING, branchOf } from "../../data/org";
import projects from "../../data/projects.json";
---
<Site title="Teams" page="teams" description="What MechaEagles' four engineering teams are building.">
  <div class="page-head wrap">
    <p class="eyebrow reveal">The engineering</p>
    <h1 class="reveal">Four teams, four kinds of machine</h1>
    <p class="lede reveal">Each team runs its own program, with its own subsystems, projects and milestones. Looking for who's who? <a href="/people/">See the people</a>.</p>
  </div>
  <div class="tpanels wrap">
    {ENGINEERING.map((t, i) => {
      const own = projects.filter((p) => p.team === t.id);
      return (
        <a class="tpanel reveal" href={`/teams/${t.id}/`} data-el={t.element} style={`--c:${t.color};--i:${i}`}>
          <span class="tpanel__art">
            <ElementArt el={t.element} />
            {t.hero && <Photo src={t.hero} loading={i < 2 ? "eager" : "lazy"} sizes="(max-width: 900px) 100vw, 50vw" />}
          </span>
          <span class="tpanel__text">
            <span class="tpanel__spirit"><Sigil el={t.element} />{t.spirit}</span>
            <strong>{t.name}</strong>
            <span class="tpanel__line">{t.tagline}</span>
            <span class="tpanel__mission">{t.mission}</span>
            <span class="tpanel__meta">{branchOf(t).everyone.length} people{own.length > 0 && ` · Current build: ${own.map((p) => p.name).join(", ")}`}</span>
          </span>
        </a>
      );
    })}
  </div>
</Site>
