---
import Site from "../../layouts/Site.astro";
import MemberCard from "../../components/cards/MemberCard.astro";
import PersonRef from "../../components/cards/PersonRef.astro";
import Sigil from "../../components/cards/Sigil.astro";
import ElementArt from "../../components/cards/ElementArt.astro";
import Empty from "../../components/Empty.astro";
import Photo from "../../components/Photo.astro";
import { ENGINEERING, TEAM, branchOf, cardOf, now, roleName, type Member } from "../../data/org";
import projectsJson from "../../data/projects.json";
import galleryJson from "../../data/gallery.json";
import videosJson from "../../data/videos.json";
import documentsJson from "../../data/documents.json";
import milestonesJson from "../../data/milestones.json";

export const getStaticPaths = () => ENGINEERING.map((t) => ({ params: { id: t.id } }));
const id = Astro.params.id as string;
const team = TEAM[id];
const branch = branchOf(team);
const of = <T extends { team: string }>(list: T[]) => list.filter((x) => x.team === id);
const projects = of(projectsJson);
const gallery = of(galleryJson);
const videos = of(videosJson);
const documents = of(documentsJson);
const milestones = of(milestonesJson) as ((typeof milestonesJson)[number] & { lessons?: string[] })[];
const subLeads = branch.groups.flatMap((g) => g.leads);
const roleHere = (m: Member) => now(m).filter((x) => x.org === id).map((x) => (x.kind === "member" ? x.subsystem ?? "Member" : roleName(x))).join(" · ");
const SECTIONS = [["overview", "Overview"], ["projects", "Projects"], ["gallery", "Gallery"], ["videos", "Videos"], ["documents", "Documents"], ["progress", "Progress"], ["team", "Team"]];
const STATE: Record<string, string> = { done: "Done", now: "In progress", next: "Upcoming" };
---
<Site title={team.name} page="team" description={team.mission} share={team.hero ? id : "home"}>
  <div class="team" data-el={team.element} style={`--c:${team.color}`}>
    <section class={`thero${team.hero ? " thero--photo" : ""}`}>
      {team.hero && <Photo class="thero__image" src={team.hero} alt={team.heroAlt ?? ""} loading="eager" fetchpriority="high" sizes="100vw" />}
      {!team.hero && <span class="thero__art" aria-hidden="true"><ElementArt el={team.element} /></span>}
      <canvas class="team-fx" data-el={team.element} data-color={team.color} aria-hidden="true"></canvas>
      <div class="thero__text wrap">
        <p class="thero__spirit"><Sigil el={team.element} />{team.spirit} · {team.tagline}</p>
        <h1>{team.name}</h1>
        <p class="thero__mission">{team.mission}</p>
        {team.status && <p class="thero__status"><i aria-hidden="true"></i>{team.status.text} · {team.status.updated}</p>}
      </div>
    </section>

    <nav class="tnav" aria-label={`${team.name} sections`}>
      <ul class="wrap">{SECTIONS.map(([key, label]) => <li><a href={`#${key}`}>{label}</a></li>)}</ul>
    </nav>

    <section class="tsec wrap" id="overview">
      <div class="tsec__head"><p class="eyebrow">Overview</p><h2>What the team does</h2></div>
      {team.overview ? (
        <div class="overview">
          <div>
            <p class="overview__lead">{team.overview}</p>
            {team.objectives.length > 0 && <>
              <h3>Engineering objectives</h3>
              <ul class="ticks">{team.objectives.map((o) => <li>{o}</li>)}</ul>
            </>}
          </div>
          {team.facts.length > 0 && (
            <dl class="facts">
              {team.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd>{f.note && <dd class="facts__note">{f.note}</dd>}</div>)}
            </dl>
          )}
        </div>
      ) : <Empty what={`A fuller overview of ${team.name}'s work and objectives.`} note="The team's mission above is on record. Details get added as the team supplies them." />}
      {team.subsystems.length > 0 && (
        <ol class="subgrid">
          {team.subsystems.map((s, i) => <li class="reveal" style={`--i:${i}`}><h3>{s.name}</h3><p>{s.detail}</p></li>)}
        </ol>
      )}
    </section>

    <section class="tsec wrap" id="projects">
      <div class="tsec__head"><p class="eyebrow">Current projects</p><h2>On the bench now</h2></div>
      {projects.length ? projects.map((p) => (
        <article class={`project reveal${p.tall ? " project--tall" : ""}`}>
          <figure><Photo src={p.image} alt={p.imageAlt} preview={!p.tall} reserve sizes={p.tall ? "300px" : "(max-width: 900px) 100vw, 50vw"} /></figure>
          <div>
            <p class="project__stage">{p.stage}{p.updated && ` · ${p.updated}`}</p>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
            {p.specs.length > 0 && <dl class="project__specs">{p.specs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl>}
            {p.note && <p class="project__note">{p.note}</p>}
          </div>
        </article>
      )) : <Empty what="Current builds, with renders, CAD and development stages." />}
    </section>

    <section class="tsec wrap" id="gallery">
      <div class="tsec__head"><p class="eyebrow">Engineering gallery</p><h2>Photos and drawings</h2></div>
      {gallery.length ? (
        <ul class="gallery">
          {gallery.map((g, i) => (
            <li class="reveal" style={`--i:${i % 4}`}>
              <button type="button" data-view={g.src} data-alt={g.alt} data-caption={[g.caption, g.date].filter(Boolean).join(" · ")} aria-label={`View larger: ${g.caption}`}>
                <Photo src={g.src} alt={g.alt} sizes="(max-width: 560px) 100vw, 300px" />
              </button>
              <p>{g.caption}{g.date && <small>{g.date}</small>}</p>
            </li>
          ))}
        </ul>
      ) : <Empty what="Photos, engineering diagrams and CAD renders." />}
    </section>

    <section class="tsec wrap" id="videos">
      <div class="tsec__head"><p class="eyebrow">Video library</p><h2>Tests, launches and builds</h2></div>
      {videos.length ? (
        <ul class="videos">
          {videos.map((v) => (
            <li>
              <video controls preload="none" poster={v.poster} playsinline>
                {v.webm && <source src={v.webm} type="video/webm" />}
                <source src={v.mp4} type="video/mp4" />
              </video>
              <div><p class="project__stage">{v.kind}{v.date && ` · ${v.date}`}</p><h3>{v.title}</h3><p>{v.description}</p></div>
            </li>
          ))}
        </ul>
      ) : <Empty what="Demonstrations, test footage and technical presentations." />}
    </section>

    <section class="tsec wrap" id="documents">
      <div class="tsec__head"><p class="eyebrow">Technical documents</p><h2>Reports and reviews</h2></div>
      {documents.length ? (
        <ul class="docs">
          {documents.map((d) => (
            <li>
              <div><p class="project__stage">{d.kind} · {d.date}</p><h3>{d.title}</h3><p>{d.description}</p></div>
              <div class="docs__actions">
                <a class="button" href={d.href} target="_blank" rel="noopener" data-astro-reload>Preview</a>
                <a class="button" href={d.href} download data-astro-reload>Download ({d.size})</a>
              </div>
            </li>
          ))}
        </ul>
      ) : <Empty what="Design reports, specifications and public review materials." />}
    </section>

    <section class="tsec wrap" id="progress">
      <div class="tsec__head"><p class="eyebrow">Progress and milestones</p><h2>Where it stands</h2></div>
      <ol class="timeline">
        {milestones.map((m) => (
          <li class={`timeline__item timeline__item--${m.state} reveal`}>
            <span class="timeline__when">{m.when}<small>{STATE[m.state]}</small></span>
            <div>
              <h3>{m.title}</h3>
              <p>{m.detail}</p>
              {m.lessons && <><h4>What we're changing</h4><ul class="ticks">{m.lessons.map((l) => <li>{l}</li>)}</ul></>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="tsec wrap" id="team">
      <div class="tsec__head"><p class="eyebrow">Team</p><h2>Who's building it</h2></div>
      <div class="tlead">
        <h3>Team lead{subLeads.length > 0 && " and subsystem leads"}</h3>
        <div class="tier__cards tier__cards--start">
          {[...branch.leads, ...subLeads.filter((m) => !branch.leads.includes(m))].map((m, i) => <MemberCard card={cardOf(m, id, "m")} hideTeam style={`--i:${i}`} />)}
        </div>
      </div>
      {branch.groups.map((g) => {
        const members = g.members;
        return members.length > 0 && (
          <div class="tgroup">
            <h3>{g.name}</h3>
            {g.detail && <p>{g.detail}</p>}
            <div class="tier__cards tier__cards--start">{members.map((m, i) => <MemberCard card={cardOf(m, id, "s")} hideTeam style={`--i:${i % 6}`} />)}</div>
          </div>
        );
      })}
      <p class="tlead__org">See how this team connects to the rest of MechaEagles on the <a href="/people/">People page</a>.</p>
    </section>

    <section class="tcta wrap">
      <h2>Build with {team.short}.</h2>
      <div class="actions"><a class="button button--solid" href="/join/">Join the team</a><a class="button" href="/sponsors/">Support this work</a></div>
    </section>
  </div>
  <dialog class="viewer" id="viewer" aria-label="Larger image">
    <button type="button" class="profile__close" data-view-close>Close</button>
    <figure><img src="" alt="" /><figcaption></figcaption></figure>
  </dialog>
</Site>
