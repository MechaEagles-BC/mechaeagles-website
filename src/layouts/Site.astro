---
/** The frame around every page. Change the navigation or footer here, or in data/site.json, and it changes everywhere. */
import { ClientRouter } from "astro:transitions";
import "../styles/lab.css";
import "../styles/cards.css";
import "../styles/pages.css";
import WorldHead from "../components/WorldHead.astro";
import WorldBackdrop from "../components/WorldBackdrop.astro";
import Stage from "../components/Stage.astro";
import ElementArt from "../components/cards/ElementArt.astro";
import { SITE } from "../data/org";
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import plex400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import plex500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";

const { title, description, page, share = "home", noindex = false } = Astro.props as { title: string; description: string; page: string; share?: string; noindex?: boolean };
const heading = page === "home" ? "MechaEagles" : `${title} · MechaEagles`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`/og/${share}.jpg`, Astro.site).href;
const organization = {
  "@context": "https://schema.org", "@type": "Organization", name: "MechaEagles", url: Astro.site!.href, logo: new URL("/apple-touch-icon.png", Astro.site).href,
  email: SITE.email, sameAs: [SITE.instagram], description: "A student-run engineering organization at Boston College.", foundingDate: "2024",
};
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{heading}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="MechaEagles" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={heading} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {page === "home" && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex500} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/brand/eagle.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <WorldHead />
    <ClientRouter fallback="none" />
    {import.meta.env.DEV && <script type="module" is:inline set:html={`import R from "/@react-refresh"; R.injectIntoGlobalHook(window); window.$RefreshReg$ = () => {}; window.$RefreshSig$ = () => (t) => t; window.__vite_plugin_react_preamble_installed__ = true;`} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <WorldBackdrop />
    <Stage />
    <header class="bar">
      <a class="logo" href="/" aria-label="MechaEagles home" data-astro-prefetch="load"><img src="/brand/eagle.webp" alt="" width="44" height="28" /><span>MechaEagles</span></a>
      <nav aria-label="Main">
        <ul class="bar__links">
          {SITE.nav.map((l) => <li><a href={l.href} class={l.page === "join" ? "bar__join" : undefined} aria-current={l.page === page ? "page" : undefined} data-astro-prefetch="load">{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="sound">
        <input class="sound__volume" type="range" min="0" max="100" step="1" aria-label="Music volume" data-sound-volume />
        <button type="button" class="bar__sound" data-sound-toggle aria-pressed="false" aria-label="Turn music on" title="Turn music on"><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
      </div>
      <button type="button" class="bar__world" data-world-switch aria-label="Change world" title="Change world">
        <svg class="only-valley-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.6" /><ellipse cx="12" cy="12" rx="10.4" ry="3.2" fill="none" stroke="currentColor" stroke-width="1.6" transform="rotate(-24 12 12)" /></svg>
        <svg class="only-space-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
      <button type="button" class="bar__menu" data-sheet-open aria-haspopup="dialog">Menu</button>
    </header>
    <dialog class="sheet" id="site-sheet" aria-label="Menu">
      <button type="button" class="sheet__close" data-sheet-close>Close</button>
      <ul>{SITE.nav.map((l) => <li><a href={l.href} aria-current={l.page === page ? "page" : undefined}>{l.label}</a></li>)}</ul>
      <div class="sheet__sound">
        <button type="button" class="bar__sound" data-sound-toggle aria-pressed="false" aria-label="Turn music on"><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
        <span>Music: <b data-sound-now>Off</b></span>
        <input class="sound__volume sound__volume--open" type="range" min="0" max="100" step="1" aria-label="Music volume" data-sound-volume />
      </div>
    </dialog>
    <main id="content"><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <div class="foot__row">
          <a class="logo" href="/"><img src="/brand/eagle.webp" alt="" width="44" height="28" loading="lazy" /><span>MechaEagles</span></a>
          <nav aria-label="Footer"><ul>{SITE.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <p>Names and portraits appear only as each member has agreed. Bios and projects are added by members themselves.</p>
      </div>
    </footer>
    <dialog class="profile" id="profile" aria-labelledby="profile-name"><div class="profile__body" id="profile-body"></div></dialog>
    {["earth", "wind", "fire", "mind", "core"].map((el) => <template id={`fx-${el}`}><ElementArt el={el} /></template>)}
    <script>
      import "../components/site";
    </script>
  </body>
</html>
