 "teams": {
  "baja": {
   "name": "Baja SAE",
   "tagline": "Earth · Off-road vehicle engineering",
   "mission": "We design, build and race a single-seat off-road vehicle for the Baja SAE collegiate series: frame, suspension, steering, braking and drivetrain, built by students in Boston College's shops.",
   "subsystems": [
    {
     "name": "Roll cage",
     "detail": "Tubular steel frame that protects the driver and carries every load path."
    },
    {
     "name": "Suspension",
     "detail": "Front and rear geometry, travel and damping for rough terrain."
    },
    {
     "name": "Steering & braking",
     "detail": "Steering rack, linkages and the hydraulic brake system."
    },
    {
     "name": "Drivetrain",
     "detail": "Power from the engine to all four wheels."
    },
    {
     "name": "Fabrication",
     "detail": "Cutting, notching, welding and machining the parts above."
    }
   ]
  },
  "aero": {
   "name": "AeroEagles",
   "tagline": "Wind · High-power rocketry",
   "mission": "AeroEagles will design, manufacture, test, launch and safely recover a reusable high-powered rocket carrying an autonomous payload. After landing, the payload finds a passive visual target and measures its distance without GPS.",
   "subsystems": [
    {
     "name": "Structure",
     "detail": "Airframe, fins, motor mount, couplers and bulkheads."
    },
    {
     "name": "CAD & integration",
     "detail": "Full-vehicle CAD, drawings and interface checks."
    },
    {
     "name": "Avionics",
     "detail": "Altimeters, tracking, power distribution and the avionics bay."
    },
    {
     "name": "Recovery",
     "detail": "Parachute sizing, dual-deployment sequencing and descent analysis."
    },
    {
     "name": "Payload",
     "detail": "Camera ring + LiDAR rangefinding on an onboard computer, no GPS."
    }
   ]
  },
  "combat-robotics": {
   "name": "Combat Robotics",
   "tagline": "Fire · Arena robots",
   "mission": "We design, manufacture, program and compete combat robots: weapons, drive systems and armor that have to survive the arena.",
   "subsystems": []
  },
  "ai-safety": {
   "name": "AI Safety",
   "tagline": "Mind · Research and governance",
   "mission": "We study how to make AI systems safe and accountable through technical research, responsible development practice and governance.",
   "subsystems": []
  },
  "programmatics": {
   "name": "Programmatics",
